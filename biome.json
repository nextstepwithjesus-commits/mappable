{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "core/**/*.ts",
      "tools/pack/**/*.ts",
      "tools/tokens/**/*.ts",
      "tools/ci/**/*.ts",
      "tests/core-*.ts",
      "tests/pack-*.ts",
      "tests/tokens*.ts",
      "tests/prototypes-*.ts",
      "tests/helpers/core-data.ts",
      "prototypes/инструменты/**/*.ts",
      "prototypes/инструменты/**/*.tsx",
      "!prototypes/инструменты/dist",
      "!prototypes/инструменты/public",
      "!core/search/versification-table.ts"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noExplicitAny": "error",
        "noAssignInExpressions": "off",
        "useIterableCallbackReturn": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useTemplate": "off"
      },
      "complexity": {
        "useLiteralKeys": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "prototypes/инструменты/**"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off",
            "noNoninteractiveTabindex": "off",
            "useFocusableInteractive": "off",
            "noNoninteractiveElementToInteractiveRole": "off",
            "useKeyWithClickEvents": "off"
          }
        }
      }
    }
  ]
}
