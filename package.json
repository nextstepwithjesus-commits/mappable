{
  "name": "toledot",
  "private": true,
  "version": "0.1.0",
  "description": "Толедот — интерактивный атлас библейских родословий",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run data && tsc --noEmit && vite build",
    "build:single": "npm run data && vite build --mode single",
    "preview": "vite preview",
    "data": "tsx tools/build-data.ts",
    "validate": "tsx tools/validate.ts",
    "id": "tsx tools/id.ts",
    "verse": "tsx tools/verse.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "append": "tsx tools/append.ts",
    "layout": "tsx tools/build-data.ts",
    "shots": "tsx tools/shots.ts",
    "coverage": "tsx tools/coverage.ts",
    "contrast": "tsx tools/contrast.ts"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@fontsource-variable/jost": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource/noto-serif-hebrew": "^5.3.0",
    "@preact/signals": "^2.11.2",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.2",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typograf": "^7.8.0",
    "vite": "^8.3.1",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.2"
  }
}
